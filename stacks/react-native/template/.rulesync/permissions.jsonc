// Per-tool permission rules, generated by rulesync. A second layer: git hooks and CI are the real backstop,
// and Phase 0 showed Codex and the Antigravity CLI can still read .env, so keep real secrets out of the repo.
{
  "permission": {
    "bash": {
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -f*": "deny",
      "git commit --no-verify*": "deny",
      "xcrun simctl erase*": "deny",
      "npm install *": "ask",
      "yarn add*": "ask",
      "pnpm add*": "ask"
    },
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "**/*.keystore": "deny",
      "**/*.jks": "deny",
      "**/*.p8": "deny",
      "**/*.p12": "deny",
      "**/*.mobileprovision": "deny"
    },
    "edit": {
      "**/project.pbxproj": "deny",
      "package.json": "ask",
      "ios/Podfile": "ask",
      "android/**/build.gradle": "ask",
      "**/Info.plist": "ask",
      "**/AndroidManifest.xml": "ask",
      ".github/workflows/**": "ask"
    }
  }
}
