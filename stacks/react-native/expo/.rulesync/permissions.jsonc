// Per-tool permission rules, generated by rulesync. A second layer: git hooks and CI are the real backstop,
// and Phase 0 showed Codex and the Antigravity CLI can still read .env, so keep real secrets out of the repo.
// Expo apps: ios/ and android/ are generated by `expo prebuild`, so they're never edited by hand.
{
  "permission": {
    "bash": {
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -f*": "deny",
      "git commit --no-verify*": "deny",
      "xcrun simctl erase*": "deny",
      "npm install *": "ask",
      "yarn add*": "ask",
      "pnpm add*": "ask",
      "npx expo install *": "ask",
      "eas *": "ask",
      "npx eas-cli*": "ask"
    },
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "**/*.keystore": "deny",
      "**/*.jks": "deny",
      "**/*.p8": "deny",
      "**/*.p12": "deny",
      "**/*.mobileprovision": "deny"
    },
    "edit": {
      "ios/**": "deny",
      "android/**": "deny",
      "package.json": "ask",
      "app.json": "ask",
      "app.config.*": "ask",
      "eas.json": "ask",
      ".github/workflows/**": "ask"
    }
  }
}
